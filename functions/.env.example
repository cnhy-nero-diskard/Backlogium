# Copy to functions/.env and fill in. This file is committed; .env is not.
#
# The 64-bit SteamID of the account to poll (starts 7656119...).
# Find it at https://steamcommunity.com/my/edit — or from your profile URL.
STEAM_ID=

# NOTE: the Steam Web API key does NOT belong here. It lives in Secret
# Manager, set once with:
#   firebase functions:secrets:set STEAM_API_KEY --project <project-id>
