<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only launcher badge: high-contrast amber disc with a dark outline and dark
    "DBG" lettering, placed in the lower-right adaptive-icon safe zone (badge outer
    radius 10dp around (69,69); worst-case reach ~31.2dp < the 33dp safe-zone radius).
    Drawn over the unchanged release foreground artwork by ic_launcher_foreground_debug.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Amber disc with dark outline (outline straddles the r=9 path, reaching r=10). -->
    <path
        android:fillColor="#FFB300"
        android:pathData="M69,60 a9,9 0 1,0 0,18 a9,9 0 1,0 0,-18 z"
        android:strokeColor="#241A02"
        android:strokeWidth="2" />
    <!-- Blocky "DBG" lettering, stroked in the outline color for high contrast. -->
    <path
        android:pathData="M62.4,65.5 V72.5 M62.4,65.5 H64 A3.5,3.5 0 0 1 64,72.5 H62.4"
        android:strokeColor="#241A02"
        android:strokeLineCap="butt"
        android:strokeWidth="1" />
    <path
        android:pathData="M68.6,65.5 V72.5 M68.6,65.5 H70 A1.75,1.75 0 0 1 70,69 H68.6 M68.7,69 H70.4 A1.75,1.75 0 0 1 70.4,72.5 H68.7"
        android:strokeColor="#241A02"
        android:strokeLineCap="butt"
        android:strokeWidth="1" />
    <path
        android:pathData="M76,66.3 V65.5 H73.4 V72.5 H76 V69 H74.6"
        android:strokeColor="#241A02"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter"
        android:strokeWidth="1" />
</vector>