<?xml version="1.0" encoding="utf-8"?>
<!-- The same explicit exclusions apply to both cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="backup_snapshots" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="backup_snapshots" />
    </device-transfer>
</data-extraction-rules>
